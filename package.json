{
  "name": "viberoom",
  "version": "0.18.0",
  "description": "viberoom: bring your AI assistants together in one conversation",
  "type": "module",
  "engines": {
    "node": ">=22.16"
  },
  "bin": {
    "viberoom": "dist/main.js"
  },
  "scripts": {
    "build": "node scripts/vendor-acp.mjs && node scripts/vendor-ui.mjs && tsc -p tsconfig.json && node scripts/prune-dist.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "dev": "npm run build && node dist/main.js --open",
    "install:global": "node scripts/install.mjs",
    "update": "node scripts/update.mjs",
    "start:bg": "node dist/main.js start",
    "icons": "node scripts/render-icon.mjs",
    "prepack": "npm run build"
  },
  "files": [
    "dist",
    "vendor",
    "ui",
    "templates",
    "assets",
    "scripts",
    "NOTICE"
  ],
  "dependencies": {
    "@agentclientprotocol/sdk": "1.5.0",
    "ajv": "8.20.0",
    "cron-parser": "5.10.1",
    "marked": "^16.4.2",
    "prismjs": "^1.30.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.81.0",
    "@agentclientprotocol/codex-acp": "1.12.0",
    "@anthropic-ai/claude-agent-sdk": "0.3.280",
    "@types/node": "^24.0.0",
    "jsdom": "26.1.0",
    "mermaid": "^11.17.2",
    "typescript": "^5.9.0"
  },
  "license": "AGPL-3.0-or-later",
  "author": "Todor Rusev <todor.rosenov.rusev@gmail.com>",
  "keywords": [
    "agents",
    "acp",
    "agent-client-protocol",
    "chat",
    "claude",
    "codex",
    "gemini",
    "cursor",
    "opencode",
    "copilot"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/todor-rusev/viberoom.git"
  },
  "homepage": "https://github.com/todor-rusev/viberoom#readme",
  "bugs": {
    "url": "https://github.com/todor-rusev/viberoom/issues"
  }
}
