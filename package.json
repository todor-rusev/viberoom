{
  "name": "viberoom",
  "version": "0.20.2",
  "description": "viberoom: bring your AI assistants together in one conversation",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/todor-rusev/viberoom.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.16"
  },
  "viberoom": {
    "contract": 1,
    "minShell": "1.0.0",
    "format": 4
  },
  "bin": {
    "viberoom": "dist/main.js"
  },
  "scripts": {
    "prepack": "node scripts/product-lock.mjs && npm run build && node scripts/graph-release-layout.mjs prepare",
    "build": "node scripts/vendor-acp.mjs && node scripts/vendor-ui.mjs && tsc -p tsconfig.json && node scripts/prune-dist.mjs && node scripts/stamp-build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "dev": "npm run build && node dist/main.js --open",
    "install:global": "node scripts/install.mjs",
    "update": "node scripts/update.mjs",
    "start:bg": "node dist/main.js start",
    "icons": "node scripts/render-icon.mjs"
  },
